	0.021837, 0.022106, 0.020643, 0.017943, 0.019228, 0.018409, 0.018021, 0.019734, 0.019344, 0.016484, 0.016743, 0.015088, 0.013902, 0.013667, 0.013968, 0.015965, 0.016209, 0.015560, 0.014907, 0.013315, 0.011004, 0.010056, 0.009530, 0.007987, 0.006558, 0.007682, 0.008400, 0.009277, 0.010890, 0.011662
	0.019718, 0.019627, 0.019180, 0.015209, 0.015213, 0.015953, 0.016115, 0.016638, 0.015831, 0.016019, 0.015509, 0.013320, 0.012317, 0.011956, 0.011033, 0.013156, 0.014575, 0.013429, 0.013730, 0.010880, 0.009299, 0.008199, 0.007258, 0.007413, 0.007221, 0.007182, 0.008537, 0.009909, 0.009833, 0.010884
