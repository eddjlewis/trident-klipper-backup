	{% if home_y %}
	G4 P1000
	G28 Y
	G91
	G1 Y-50 F8000
	G90
	{% endif %}
	
	{% if home_x %}
	
	{% if not home_y and printer.toolhead.position.y < 100 %}
	G1 Y100 F3000
	{% endif %}
	
	G4 P1000
	G28 X
	G91
	G1 X-10 F8000
	G90
	{% endif %}

