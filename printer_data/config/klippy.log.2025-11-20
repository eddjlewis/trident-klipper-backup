[gcode_macro _SAFE_HOME_XY]
gcode = 
	
	{% set HA = printer.toolhead.homed_axes %}
	
	
	{% set home_both = 'X' not in params.AXIS and 'Y' not in params.AXIS %}
	
	
	
	
	
	{% set home_y = home_both or 'Y' in params.AXIS or ('X' in params.AXIS and 'y' not in HA) %}
	
	
	
	
	{% set home_x = home_both or 'X' in params.AXIS %}
	
	
	{% if home_y %}
	
	G4 P1000
	RESPOND PREFIX="[_SAFE_HOME_XY]" MSG="About to call G28 Y - watch for recursive [OVERRIDE-ENTRY]"
	
	G28 Y
	RESPOND PREFIX="[_SAFE_HOME_XY]" MSG="G28 Y returned"
	
	G91
	
	G1 Y-50 F8000
	
	G90
	{% endif %}
	
	
	{% if home_x %}
	
	
	{% if not home_y and printer.toolhead.position.y < 100 %}
	
	
	G1 Y100 F3000
	{% endif %}
	
	
	G4 P700
	RESPOND PREFIX="[_SAFE_HOME_XY]" MSG="About to call G28 X - watch for recursive [OVERRIDE-ENTRY]"
	
	G28 X
	RESPOND PREFIX="[_SAFE_HOME_XY]" MSG="G28 X returned"
	
	G91
	
	G1 X-10 F8000
	
	G90
	{% endif %}
description = Safely home X and/or Y axes with proper backoff moves

